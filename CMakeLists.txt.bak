cmake_minimum_required(VERSION 3.10)
project(EchoServer CXX)

# Установка стандарта C++ (C++11 или новее)
set(CMAKE_CXX_STANDARD 11)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Для Windows потребуется Winsock
if(WIN32)
    add_definitions(-D_WIN32_WINNT=0x0601)
    set(PLATFORM_LIBS ws2_32)
else()
    set(PLATFORM_LIBS)
endif()

# Создаем исполняемый файл
add_executable(echo_server
    src/main.cpp
)

# Подключаем системные библиотеки
target_link_libraries(echo_server PRIVATE ${PLATFORM_LIBS})

# Установка выходного каталога (опционально)
set(EXECUTABLE_OUTPUT_PATH ${CMAKE_BINARY_DIR}/bin)

# Включение всех предупреждений компилятора
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(echo_server PRIVATE -Wall -Wextra -pedantic)
endif()